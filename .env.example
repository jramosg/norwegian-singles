# Application Settings
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
SITE_URL=https://norwegian-singles.app
PUBLIC_SITE_URL=https://norwegian-singles.app

# Stripe Checkout (server-side only; never expose STRIPE_SECRET_KEY publicly)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_EXPORT_PRICE_ID=price_xxx
STRIPE_BUNDLE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Paid-order fulfillment email
RESEND_API_KEY=re_xxx
FULFILLMENT_FROM_EMAIL=Norwegian Singles <orders@norwegian-singles.app>
SUPPORT_EMAIL=support@norwegian-singles.app
REMINDER_CRON_SECRET=change_me_to_a_long_random_value

# Durable server-side checkout order store
ORDER_STORE_DIR=/app/data/orders

# GitHub Secrets needed for deployment:
# SERVER_HOST: Your VPS IP or domain
# SERVER_USER: Your SSH username (usually root)
# SERVER_SSH_KEY: Private SSH key
# SITE_URL: Your production URL
# SITE_PORT: (Optional) defaults to 4321
