# Application Settings
NODE_ENV=production
HOST=0.0.0.0
PORT=4321
SITE_URL=https://norwegian-singles.app

# --- Server-side secrets (never commit real values) -------------------------
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One Price per tier, plus the all-tiers bundle
STRIPE_PRICE_SINGLES75=price_...
STRIPE_PRICE_SINGLES95=price_...
STRIPE_PRICE_SINGLES120=price_...
STRIPE_PRICE_SINGLES140=price_...
STRIPE_PRICE_BUNDLE=price_...

# Signing secret for plan access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLAN_TOKEN_SECRET=

# Transactional email. Sending needs DNS records on the domain, not a mailbox.
RESEND_API_KEY=re_...
MAIL_FROM=plans@mail.norwegian-singles.app
MAIL_REPLY_TO=

# --- Build-time (inlined into the client bundle) ----------------------------
# Passed to `docker build` as --build-arg, because the build runs in CI.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# GitHub Secrets needed for deployment:
# SERVER_HOST: Your VPS IP or domain
# SERVER_USER: Your SSH username (usually root)
# SERVER_SSH_KEY: Private SSH key
# SITE_URL: Your production URL
# SITE_PORT: (Optional) defaults to 4321
# Plus every secret listed above.
