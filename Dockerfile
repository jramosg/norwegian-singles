FROM node:26-alpine AS base
WORKDIR /app

# Node 25+ no longer bundles Corepack, so install the pnpm from
# packageManager with npm. pnpm-workspace.yaml lists the install scripts
# pnpm may run.
RUN npm install -g pnpm@12.18.0
ENV PNPM_STORE_PATH=/pnpm/store

# Copy only manifest files to leverage build cache
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

FROM base AS prod-deps
RUN pnpm install --prod --frozen-lockfile

FROM base AS build-deps
RUN pnpm install --frozen-lockfile

FROM build-deps AS build
COPY . .
RUN pnpm run build

FROM nginx:alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
# Redirect rules are generated by the build; keep them out of the web root.
RUN mv /usr/share/nginx/html/nginx-redirects.conf /etc/nginx/redirects.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]