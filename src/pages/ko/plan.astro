---
import AppLayout from '../../layouts/AppLayout.astro';
import PlanViewer from '../../components/react/PlanViewer';
import MethodologySection from '../../components/MethodologySection.astro';
import PlanRevenue from '../../components/PlanRevenue.astro';
import { useTranslations } from '../../i18n/ui';

const locale = 'ko';
const t = useTranslations(locale);
---

<AppLayout
  title={`${t('plan.title')} - Norwegian Singles`}
  description={t('seo.description')}
  locale={locale}
>
  <div class="plan-page section">
    <div class="container">
      <header class="page-header">
        <h1>{t('plan.title')}</h1>
      </header>

      <PlanViewer locale={locale} client:load />

      <PlanRevenue locale={locale} />

      <MethodologySection locale={locale} includeNotes={false} />
    </div>
  </div>
</AppLayout>

<style>
  .plan-page {
    padding-top: var(--space-8);
  }
  .page-header {
    margin-bottom: var(--space-8);
    text-align: center;
  }
</style>
