---
import { defaultLocale, languageLabels, locales } from '../i18n/ui';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="describedby" href="/llms.txt" />
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
    <title>Norwegian Singles</title>
    <script
      is:inline
      define:vars={{ supportedLocales: locales, fallbackLocale: defaultLocale }}
    >
      (function () {
        const matchLocale = (language) => {
          const normalized = String(language || '').toLowerCase();
          return (
            supportedLocales.find(
              (locale) => locale.toLowerCase() === normalized,
            ) ||
            supportedLocales.find(
              (locale) =>
                locale.toLowerCase().split('-')[0] === normalized.split('-')[0],
            )
          );
        };

        let selected;
        try {
          selected = matchLocale(localStorage.getItem('ns-locale'));
        } catch {
          // Browser language still works when storage is unavailable.
        }

        const languages = navigator.languages?.length
          ? navigator.languages
          : [navigator.language];
        const preferred = languages.map(matchLocale).find(Boolean);
        const locale = selected || preferred || fallbackLocale;
        window.location.replace(
          `/${locale}/${window.location.search}${window.location.hash}`,
        );
      })();
    </script>
  </head>
  <body>
    <nav aria-label="Language">
      {
        locales.map((locale) => (
          <a href={`/${locale}/`} lang={locale}>
            {languageLabels[locale].nativeName}
          </a>
        ))
      }
    </nav>
  </body>
</html>
