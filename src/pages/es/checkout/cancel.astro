---
import AppLayout from '../../../layouts/AppLayout.astro';

const locale = 'es';
---

<AppLayout
  title="Pago cancelado - Norwegian Singles"
  description="Tu pago de Norwegian Singles se ha cancelado."
  locale={locale}
>
  <section class="checkout-result section">
    <div class="container checkout-container">
      <div class="checkout-panel">
        <span class="checkout-kicker">Pago cancelado</span>
        <h1>No se ha realizado ningún cargo</h1>
        <p>
          Tu plan sigue disponible. Puedes volver, ajustar el paquete y
          reiniciar el pago cuando quieras.
        </p>

        <div class="checkout-actions">
          <a class="btn btn-primary" href="/es/plan">Volver al checkout</a>
          <a class="btn btn-secondary" href="/es">Crear otro plan</a>
        </div>
      </div>
    </div>
  </section>
</AppLayout>

<style>
  .checkout-container {
    max-width: 720px;
  }

  .checkout-panel {
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .checkout-kicker {
    color: var(--color-accent-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .checkout-panel h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-3xl);
  }

  .checkout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
