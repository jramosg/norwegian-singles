---
import LandingPage from '../../components/LandingPage.astro';
import RaceInputPage from '../../components/RaceInputPage.astro';
import MarathonHub from '../../components/marathon/MarathonHub.astro';
import TierPage from '../../components/marathon/TierPage.astro';
import {
  createSeoStructuredData,
  getSeoPage,
  getSeoPages,
} from '../../lib/seo-pages';
import {
  createRaceSeoStructuredData,
  getRacePage,
  getRacePages,
} from '../../lib/race-seo-pages';
import {
  getMarathonIndexPage,
  getMarathonTierPage,
  getMarathonTierPages,
} from '../../lib/marathon/tier-pages';

const locale = 'en';

export function getStaticPaths() {
  const seoPages = getSeoPages('en').map((page) => ({
    params: { slug: page.slug },
    props: { page, racePage: null, tierPage: null, marathonHub: null },
  }));
  const racePages = getRacePages('en').map((page) => ({
    params: { slug: page.slug },
    props: { page: null, racePage: page, tierPage: null, marathonHub: null },
  }));
  const tierPages = getMarathonTierPages('en').map((page) => ({
    params: { slug: page.slug },
    props: { page: null, racePage: null, tierPage: page, marathonHub: null },
  }));
  // Undefined for any locale whose marathon copy is not translated yet.
  const hub = getMarathonIndexPage('en');
  const hubPages = hub
    ? [
        {
          params: { slug: hub.slug },
          props: {
            page: null,
            racePage: null,
            tierPage: null,
            marathonHub: hub,
          },
        },
      ]
    : [];
  return [...seoPages, ...racePages, ...tierPages, ...hubPages];
}

const { page, racePage, tierPage, marathonHub } = Astro.props;
const slug = Astro.params.slug || '';
const foundPage = page || getSeoPage(locale, slug);
const foundRacePage = racePage || getRacePage(locale, slug);
const foundTierPage = tierPage || getMarathonTierPage(locale, slug);
const foundHub =
  marathonHub ??
  (getMarathonIndexPage(locale)?.slug === slug
    ? getMarathonIndexPage(locale)
    : null);

if (!foundPage && !foundRacePage && !foundTierPage && !foundHub) {
  return Astro.redirect(`/${locale}/`);
}

const structuredData = foundRacePage
  ? createRaceSeoStructuredData(locale, foundRacePage)
  : foundPage
    ? createSeoStructuredData(locale, foundPage)
    : undefined;
---

{
  foundHub ? (
    <MarathonHub page={foundHub} />
  ) : foundTierPage ? (
    <TierPage page={foundTierPage} />
  ) : foundRacePage ? (
    <RaceInputPage
      locale={locale}
      page={foundRacePage}
      structuredData={structuredData}
    />
  ) : (
    <LandingPage
      locale={locale}
      title={foundPage!.title}
      description={foundPage!.description}
      seoHeading={foundPage!.h1}
      seoIntro={foundPage!.intro}
      structuredData={structuredData}
    />
  )
}
