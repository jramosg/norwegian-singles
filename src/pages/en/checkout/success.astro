---
import AppLayout from '../../../layouts/AppLayout.astro';

const locale = 'en';
---

<AppLayout
  title="Checkout complete - Norwegian Singles"
  description="Your Norwegian Singles checkout is complete."
  locale={locale}
>
  <section class="checkout-result section">
    <div class="container checkout-container">
      <div class="checkout-panel">
        <span class="checkout-kicker">Payment complete</span>
        <h1>Your order is confirmed</h1>
        <p>
          The receipt and delivery details will be sent to your email. Keep this
          page open until the email arrives.
        </p>

        <dl class="checkout-summary" id="checkout-summary">
          <div>
            <dt>Order</dt>
            <dd id="checkout-order">Processing</dd>
          </div>
          <div>
            <dt>Product</dt>
            <dd id="checkout-product">Plan export</dd>
          </div>
        </dl>

        <div class="checkout-actions">
          <a class="btn btn-primary" href="/en/plan">Back to my plan</a>
          <a class="btn btn-secondary" href="/en">Create another plan</a>
        </div>
      </div>
    </div>
  </section>
</AppLayout>

<script is:inline>
  (function () {
    try {
      const raw = localStorage.getItem('ns-pending-order');
      if (!raw) return;
      const order = JSON.parse(raw);
      document.getElementById('checkout-order').textContent = order.id || '';
      document.getElementById('checkout-product').textContent =
        order.productId === 'bundle'
          ? 'Marathon + reminders bundle'
          : 'Basic export';
      localStorage.setItem('ns-last-order', raw);
      localStorage.removeItem('ns-pending-order');
    } catch {}
  })();
</script>

<style>
  .checkout-container {
    max-width: 720px;
  }

  .checkout-panel {
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .checkout-kicker {
    color: var(--color-easy);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .checkout-panel h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-3xl);
  }

  .checkout-summary {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }

  .checkout-summary div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .checkout-summary dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .checkout-summary dd {
    color: var(--color-text-primary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-align: right;
  }

  .checkout-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
