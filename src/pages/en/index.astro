---
import AppLayout from '../../layouts/AppLayout.astro';
import TrainingForm from '../../components/react/TrainingForm';
import MethodologySection from '../../components/MethodologySection.astro';
import BookRecommendations from '../../components/BookRecommendations.astro';
import { useTranslations } from '../../i18n/ui';

const locale = 'en';
const t = useTranslations(locale);
---

<AppLayout
  title={t('seo.title')}
  description={t('seo.description')}
  locale={locale}
>
  <div class="landing">
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            {t('hero.title')}
            <span class="hero-accent">{t('hero.titleAccent')}</span>
          </h1>
          <p class="hero-subtitle">{t('hero.subtitle')}</p>
        </div>

        <div class="form-card card glass">
          <div class="card-header">
            <h2 class="card-title">{t('form.title')}</h2>
          </div>
          <div class="card-body">
            <TrainingForm locale={locale} client:load />
          </div>
        </div>
      </div>
    </section>

    <MethodologySection locale={locale} />

    <BookRecommendations locale={locale} />

    <section class="seo-content section">
      <div class="container seo-container">
        <h2>{t('seo.content.h2')}</h2>
        <p set:html={t('seo.content.intro')} />

        <h3>{t('seo.content.doubleThreshold.title')}</h3>
        <p set:html={t('seo.content.doubleThreshold.text')} />

        <h3>{t('seo.content.howItWorks.title')}</h3>
        <p set:html={t('seo.content.howItWorks.text')} />
        <ul>
          <li set:html={t('seo.content.howItWorks.rep3')} />
          <li set:html={t('seo.content.howItWorks.rep6')} />
          <li set:html={t('seo.content.howItWorks.rep10')} />
        </ul>
        <p set:html={t('seo.content.howItWorks.paces')} />

        <h3>{t('seo.content.weeklyPlans.title')}</h3>
        <p set:html={t('seo.content.weeklyPlans.text')} />

        <h3>{t('seo.content.marathon.title')}</h3>
        <p set:html={t('seo.content.marathon.text')} />

        <h3>{t('seo.content.whoIsItFor.title')}</h3>
        <p set:html={t('seo.content.whoIsItFor.text')} />
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .landing {
    background: var(--color-bg-primary);
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: var(--space-8) 0;
  }

  .hero .container {
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero-content {
    text-align: center;
  }
  @media (min-width: 1024px) {
    .hero-content {
      text-align: left;
    }
  }

  .hero-title {
    font-size: var(--text-4xl);
    line-height: 1.1;
    margin-bottom: var(--space-4);
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-5xl);
    }
  }
  @media (min-width: 1024px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }

  .hero-accent {
    background: var(--color-accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 500px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .hero-subtitle {
      margin: 0;
    }
  }

  .form-card {
    max-width: 520px;
    margin: 0 auto;
  }
  @media (min-width: 1024px) {
    .form-card {
      margin: 0;
    }
  }

  .seo-content {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }
  .seo-container {
    max-width: 720px;
  }
  .seo-content h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-6);
  }
  .seo-content h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .seo-content p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: var(--space-4);
  }
  .seo-content ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .seo-content li {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.75;
    padding-left: var(--space-5);
    position: relative;
  }
  .seo-content li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent-primary);
  }
  .seo-content strong {
    color: var(--color-text-primary);
    font-weight: var(--font-semibold);
  }
  .seo-content em {
    color: var(--color-text-primary);
  }
</style>
