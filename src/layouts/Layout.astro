---
import '../styles/global.css';
import '../styles/components.css';
import '@fontsource-variable/inter';
import { useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;

const t = useTranslations(locale);

const title = Astro.props.title || t('seo.title');
const description = Astro.props.description || t('seo.description');

const alternateLocale = locale === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;
const alternatePath = currentPath.replace(`/${locale}`, `/${alternateLocale}`);
const siteURL = 'https://norwegian-singles.app';

const canonicalURL = new URL(currentPath, Astro.site || siteURL);
const alternateURL = new URL(alternatePath, Astro.site || siteURL);

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Norwegian Singles',
  url: siteURL,
  description: description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Jonramos',
    url: 'https://jonramos.dev',
  },
};

const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name:
        locale === 'es'
          ? '¿Qué es el método Norwegian Singles (NSM)?'
          : 'What is the Norwegian Singles Method (NSM)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          locale === 'es'
            ? 'El NSM es un método de entrenamiento de resistencia que usa carreras sub-umbral repetibles (intervals de 3, 6 y 10 min con 60s de descanso) para mejorar el rendimiento sin acumular fatiga excesiva.'
            : 'NSM is an endurance training method using repeatable sub-threshold sessions (3, 6, and 10-min intervals with 60s recovery) to build performance without excessive fatigue accumulation.',
      },
    },
    {
      '@type': 'Question',
      name:
        locale === 'es'
          ? '¿Cómo calculo mi ritmo sub-umbral?'
          : 'How do I calculate my sub-threshold pace?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          locale === 'es'
            ? 'Introduce tu marca de 5K en el formulario y esta app calculará automáticamente tus ritmos para intervalos de 3, 6 y 10 minutos usando la Tabla 1.4 del libro NSM.'
            : 'Enter your 5K race time in the form and this app automatically calculates your paces for 3, 6, and 10-minute intervals using Table 1.4 from the NSM book.',
      },
    },
    {
      '@type': 'Question',
      name:
        locale === 'es'
          ? '¿Cuántas horas debo entrenar a la semana?'
          : 'How many hours should I train per week?',
      acceptedAnswer: {
        '@type': 'Answer',
        text:
          locale === 'es'
            ? 'El NSM ofrece planes desde 4.5 hasta 8 horas semanales. Si empiezas, comienza en el nivel 4.5-5.5h. Aumenta gradualmente cuando el plan actual se sienta cómodo durante varias semanas.'
            : 'NSM offers plans from 4.5 to 8 hours per week. If starting out, begin at the 4.5–5.5h level. Increase gradually once the current plan feels comfortable for several consecutive weeks.',
      },
    },
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ef4444" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical & Alternates -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={locale} href={canonicalURL.href} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateURL.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Norwegian Singles" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={`${siteURL}/og-image.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}/og-image.png`} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaData)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(faqData)}
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- Language persistence script -->
    <script is:inline>
      (function () {
        const path = window.location.pathname;
        const locale = path.split('/')[1];
        if (locale === 'es' || locale === 'en') {
          localStorage.setItem('ns-locale', locale);
        }
      })();
    </script>
  </body>
</html>
