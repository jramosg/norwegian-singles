---
import '../styles/global.css';
import '../styles/components.css';
import '@fontsource-variable/inter';
import type { Locale } from '../types';
import { languageLabels, locales, useTranslations } from '../i18n/ui';
import { getAlternateSeoPath } from '../lib/seo-pages';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  structuredData?: Record<string, unknown>[];
}

const { locale = 'en' } = Astro.props;

const t = useTranslations(locale);

const title = Astro.props.title || t('seo.title');
const description = Astro.props.description || t('seo.description');
const structuredData = Astro.props.structuredData || [];
const floatingSupportMessage = t('support.floatingMessage');
const floatingSupportButton = t('support.floatingButton');
const floatingSupportAria = t('support.floatingAria');

const currentPath = Astro.url.pathname;
const siteURL = 'https://norwegian-singles.app';

const canonicalURL = new URL(currentPath, Astro.site || siteURL);
const localeUrls = locales.map((lang) => {
  const path =
    lang === locale
      ? currentPath
      : getAlternateSeoPath(currentPath, locale, lang) ||
        currentPath.replace(`/${locale}`, `/${lang}`);

  return {
    lang,
    url: new URL(path, Astro.site || siteURL),
  };
});
const defaultURL = new URL(
  localeUrls.find(({ lang }) => lang === 'en')?.url.pathname || currentPath,
  Astro.site || siteURL,
);

const schemaData = {
  '@context': 'https://schema.org',
  '@type': ['WebApplication', 'SoftwareApplication'],
  name: 'Norwegian Singles Method Calculator',
  alternateName: [
    'Norwegian Singles Calculator',
    'Norwegian Singles App',
    'Norwegian Singles Method App',
    'NSA Pace Calculator',
    'NSM Calculator',
    'NSM Pace Calculator',
    'NSM Running',
    'Norwegian Singles Approach Calculator',
    'Norwegian Singles Method Calculator',
    'Norwegian Method Training Planner',
    'Marius Bakken Pace Calculator',
    'James Copeland Norwegian Singles Calculator',
  ],
  url: siteURL,
  description: description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Jonramos',
    url: 'https://jonramos.dev',
  },
  about: {
    '@type': 'Thing',
    name: 'Norwegian Singles Approach / Method',
    description:
      'A sub-threshold running approach that adapts Norwegian-style threshold principles into single-session training weeks for recreational and competitive runners.',
    sameAs: [],
  },
  keywords:
    'NSA, NSM, Norwegian Singles calculator, Norwegian Singles Approach, Norwegian Singles Method, NSM calculator, NSM running, Norwegian method calculator, sub-threshold pace calculator, Marius Bakken pace calculator, James Copeland Norwegian Singles, running training plan, 5K pace calculator, marathon training',
};

const allStructuredData = [schemaData, ...structuredData];
---

<!doctype html>
<html lang={locale} data-locale={locale} data-seo-page={currentPath}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ef4444" />
    <meta name="author" content="Jon Ramos" />
    <meta
      name="keywords"
      content={locale === 'es'
        ? 'NSA, NSM, calculadora Norwegian Singles, Norwegian Singles Method, calculadora NSM, método noruego, sub-umbral, calculadora ritmos Marius Bakken, James Copeland Norwegian Singles, plan entrenamiento correr, calculadora ritmo 5K, preparación maratón'
        : locale === 'ko'
          ? 'NSM 러닝, NSM 훈련법, Norwegian Singles Method, Norwegian Singles 계산기, NSM 계산기, 서브스레숄드 러닝, 노르웨이식 훈련, 마라톤 훈련 플랜, 5K 페이스 계산기'
          : locale === 'de'
            ? 'NSA, NSM, Norwegian Singles Rechner, Norwegian Singles Method, NSM Rechner, norwegische Methode, Sub-Threshold, Schwellentraining, Marius Bakken Pace-Rechner, James Copeland Norwegian Singles, Laufplan, 5K Pace-Rechner, Marathontraining, Norwegian Singles App'
            : locale === 'fr'
              ? 'NSA, NSM, calculateur Norwegian Singles, Norwegian Singles Method, calculateur NSM, méthode norvégienne, sous-seuil, allure seuil, calculateur Marius Bakken, James Copeland Norwegian Singles, plan entraînement course, calculateur allure 5K, entraînement marathon, application Norwegian Singles'
              : 'NSA, NSM, Norwegian Singles calculator, Norwegian Singles app, Norwegian Singles Approach, Norwegian Singles Method, NSM calculator, NSM running, Norwegian method calculator, sub-threshold pace calculator, Marius Bakken pace calculator, James Copeland Norwegian Singles, running training plan, 5K pace calculator, marathon training'}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical & Alternates -->
    <link rel="canonical" href={canonicalURL.href} />
    {
      localeUrls.map(({ lang, url }) => (
        <link
          rel="alternate"
          hreflang={languageLabels[lang].hreflang}
          href={url.href}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Norwegian Singles" />
    <meta property="og:locale" content={languageLabels[locale].og} />
    <meta property="og:image" content={`${siteURL}/og-image.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}/og-image.png`} />

    <!-- Structured Data -->
    {
      allStructuredData.map((data) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data)}
        />
      ))
    }

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <a
      class="floating-support"
      href="https://buymeacoffee.com/jramosg"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={floatingSupportAria}
    >
      <span class="floating-support-message" aria-hidden="true">
        {floatingSupportMessage}
      </span>
      <span aria-hidden="true">☕</span>
      <span class="floating-support-text">{floatingSupportButton}</span>
    </a>

    <script is:inline>
      window.setTimeout(() => {
        document
          .querySelector('.floating-support-message')
          ?.classList.add('is-hidden');
      }, 6000);
    </script>

    <!-- Language persistence script -->
    <script is:inline>
      (function () {
        const path = window.location.pathname;
        const locale = path.split('/')[1];
        if (['en', 'es', 'ko', 'de', 'fr'].includes(locale)) {
          localStorage.setItem('ns-locale', locale);
        }
      })();
    </script>
  </body>
</html>
