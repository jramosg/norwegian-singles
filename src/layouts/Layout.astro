---
import '../styles/global.css';
import '../styles/components.css';
import '@fontsource-variable/inter';
import { useTranslations } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;

const t = useTranslations(locale);

const title = Astro.props.title || t('seo.title');
const description = Astro.props.description || t('seo.description');

const alternateLocale = locale === 'es' ? 'en' : 'es';
const currentPath = Astro.url.pathname;
const alternatePath = currentPath.replace(`/${locale}`, `/${alternateLocale}`);
const siteURL = 'https://norwegian-singles.app';

const canonicalURL = new URL(currentPath, Astro.site || siteURL);
const alternateURL = new URL(alternatePath, Astro.site || siteURL);

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Norwegian Singles Method Calculator',
  alternateName: ['NSM Calculator', 'Norwegian Method Training Planner'],
  url: siteURL,
  description: description,
  applicationCategory: 'HealthApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Jonramos',
    url: 'https://jonramos.dev',
  },
  about: {
    '@type': 'Thing',
    name: 'Norwegian Singles Method',
    description:
      "A sub-threshold running training system created by James Copeland (sirpoc), adapting Marius Bakken's elite double threshold method into single daily sessions for recreational and competitive runners.",
    sameAs: [],
  },
  keywords:
    'Norwegian method, Norwegian Singles, NSM, sub-threshold, lactate threshold, Marius Bakken, James Copeland, sirpoc, double threshold, running training plan, 5K pace calculator, marathon training',
};

const faqEntries = [
  {
    en: {
      q: 'What is the Norwegian Singles Method (NSM)?',
      a: "The Norwegian Singles Method is James Copeland's (sirpoc) adaptation of Marius Bakken's elite double threshold training system. It simplifies the Norwegian Method into single daily sub-threshold sessions — 3, 6, and 10-minute intervals with short recovery — maximizing aerobic gains while minimizing injury risk through controlled intensity and high consistency.",
    },
    es: {
      q: '¿Qué es el método Norwegian Singles (NSM)?',
      a: 'El Norwegian Singles Method es la adaptación de James Copeland (sirpoc) del sistema de doble umbral de Marius Bakken. Simplifica el Método Noruego en sesiones sub-umbral únicas diarias — intervalos de 3, 6 y 10 minutos con recuperaciones cortas — maximizando las ganancias aeróbicas y minimizando el riesgo de lesión.',
    },
  },
  {
    en: {
      q: 'How is NSM different from the original Norwegian double threshold method?',
      a: 'The original Norwegian Method, popularized by Jakob Ingebrigtsen and Marius Bakken, uses two threshold sessions per day (morning and evening). NSM condenses this into a single daily sub-threshold session, making it accessible for recreational runners who cannot train twice a day while preserving the core lactate management principles.',
    },
    es: {
      q: '¿En qué se diferencia NSM del método noruego de doble umbral original?',
      a: 'El Método Noruego original, popularizado por Jakob Ingebrigtsen y Marius Bakken, usa dos sesiones de umbral al día (mañana y tarde). NSM condensa esto en una única sesión sub-umbral diaria, haciéndolo accesible para corredores recreativos que no pueden entrenar dos veces al día, preservando los principios de gestión de lactato.',
    },
  },
  {
    en: {
      q: 'How do I calculate my sub-threshold pace?',
      a: 'Enter your 5K race time (or 10K time) in the calculator and it automatically computes your three sub-threshold paces using Table 1.4 from the NSM book: 3-minute rep pace (~15K race effort), 6-minute rep pace (~30K effort), and 10-minute rep pace (close to marathon effort). It also calculates your easy pace from Table 2.3.',
    },
    es: {
      q: '¿Cómo calculo mi ritmo sub-umbral?',
      a: 'Introduce tu marca de 5K (o 10K) en la calculadora y automáticamente calcula tus tres ritmos sub-umbral usando la Tabla 1.4 del libro NSM: ritmo de repetición de 3 minutos (~esfuerzo de 15K), ritmo de 6 minutos (~esfuerzo de 30K), y ritmo de 10 minutos (cercano al ritmo de maratón). También calcula tu ritmo fácil de la Tabla 2.3.',
    },
  },
  {
    en: {
      q: 'How many hours per week should I train with NSM?',
      a: 'NSM offers structured weekly plans from 4.5 to 9 hours. Begin at 4.5–5.5h if new to the method. Each tier prescribes three sub-threshold sessions (Tuesday, Thursday, Saturday) plus easy runs. Progress to the next tier when your current plan feels comfortable for several consecutive weeks.',
    },
    es: {
      q: '¿Cuántas horas debo entrenar a la semana con NSM?',
      a: 'NSM ofrece planes semanales estructurados de 4.5 a 9 horas. Empieza en 4.5–5.5h si eres nuevo en el método. Cada nivel prescribe tres sesiones sub-umbral (martes, jueves, sábado) más rodajes fáciles. Progresa al siguiente nivel cuando el plan actual se sienta cómodo durante varias semanas consecutivas.',
    },
  },
  {
    en: {
      q: 'What book is the Norwegian Singles Method from?',
      a: '"NSM: Subthreshold Running Kept Simple" by James Copeland. The book provides the complete pace tables, weekly training structures, tapering protocols, and a 15-week marathon build plan. This calculator implements the book\'s tables and plans digitally.',
    },
    es: {
      q: '¿De qué libro viene el Norwegian Singles Method?',
      a: '"NSM: Subthreshold Running Kept Simple" de James Copeland. El libro proporciona las tablas completas de ritmos, estructuras semanales de entrenamiento, protocolos de tapering y un plan de preparación de maratón de 15 semanas. Esta calculadora implementa las tablas y planes del libro digitalmente.',
    },
  },
  {
    en: {
      q: 'Can I use NSM to train for a marathon?',
      a: 'Yes. This app includes the full 15-week "My Marathon Build" from the NSM book. Enter your marathon date and the app generates a progressive plan with sub-threshold sessions, marathon-pace specific workouts, tune-up races (parkrun, 10K, half marathon), and a proper taper leading to race day.',
    },
    es: {
      q: '¿Puedo usar NSM para preparar un maratón?',
      a: 'Sí. Esta app incluye el plan completo de 15 semanas "My Marathon Build" del libro NSM. Introduce la fecha de tu maratón y la app genera un plan progresivo con sesiones sub-umbral, sesiones específicas a ritmo maratón, carreras de puesta a punto (parkrun, 10K, media maratón) y un tapering adecuado.',
    },
  },
  {
    en: {
      q: 'Why 60-second recoveries between intervals?',
      a: 'Short 60-second recoveries (90–120s for longer 10-minute reps) are a core principle of the Norwegian Method. They keep blood lactate slightly elevated between repetitions, training your body to clear lactate efficiently at race pace — the key physiological adaptation that makes threshold training effective.',
    },
    es: {
      q: '¿Por qué recuperaciones de 60 segundos entre intervalos?',
      a: 'Las recuperaciones cortas de 60 segundos (90–120s para repeticiones largas de 10 minutos) son un principio central del Método Noruego. Mantienen el lactato en sangre ligeramente elevado entre repeticiones, entrenando al cuerpo a aclarar lactato eficientemente a ritmo de carrera — la adaptación fisiológica clave del entrenamiento de umbral.',
    },
  },
];

const faqData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((entry) => ({
    '@type': 'Question',
    name: entry[locale].q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry[locale].a,
    },
  })),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ef4444" />
    <meta name="author" content="Jon Ramos" />
    <meta
      name="keywords"
      content={locale === 'es'
        ? 'método noruego, Norwegian Singles, NSM, sub-umbral, entrenamiento umbral lactato, Marius Bakken, James Copeland, sirpoc, doble umbral, plan entrenamiento correr, calculadora ritmo 5K, preparación maratón, entrenamiento resistencia'
        : 'Norwegian method, Norwegian Singles Method, NSM, sub-threshold, lactate threshold training, Marius Bakken, James Copeland, sirpoc, double threshold, running training plan, 5K pace calculator, marathon training, endurance training'}
    />

    <!-- Preconnect to Buy Me a Coffee CDNs (floating widget) -->
    <link rel="preconnect" href="https://cdnjs.buymeacoffee.com" crossorigin />
    <link rel="preconnect" href="https://cdn.buymeacoffee.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical & Alternates -->
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="alternate" hreflang={locale} href={canonicalURL.href} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateURL.href} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Norwegian Singles" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={`${siteURL}/og-image.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}/og-image.png`} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(schemaData)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(faqData)}
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- Buy Me a Coffee floating widget (non-critical, load off the
         critical path so it doesn't block render or the LCP) -->
    <script
      is:inline
      async
      data-name="BMC-Widget"
      data-cfasync="false"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="jramosg"
      data-description="Support the Norwegian Singles project"
      data-message="Enjoying the free training planner? Fuel the next features with a coffee ☕"
      data-color="#FFDD00"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"></script>

    <!-- Language persistence script -->
    <script is:inline>
      (function () {
        const path = window.location.pathname;
        const locale = path.split('/')[1];
        if (locale === 'es' || locale === 'en') {
          localStorage.setItem('ns-locale', locale);
        }
      })();
    </script>
  </body>
</html>
