---

<section
  class:list={[
    'recs-section',
    'section',
    { 'recs-section--plan': placement === 'plan' },
  ]}
  aria-labelledby={`recs-title-${placement}`}
>
  <div class="container recs-container">
    <div class="recs-head">
      {placement === 'plan' && <p class="recs-eyebrow">{copy.eyebrow}</p>}
      <h2 id={`recs-title-${placement}`} class="section-title">
        {copy.title}
      </h2>
      <p class="recs-subtitle">{copy.subtitle}</p>
    </div>

    <div class="recs-grid">
      {
        gear.map((item) => (
          <a
            class="rec-card"
            href={item.link}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            data-monetization="affiliate"
            data-placement={placement}
            data-item={item.key}
          >
            <div class="rec-cover-wrap">
              {item.cover && imageMap[item.cover] ? (
                <Image
                  src={imageMap[item.cover]}
                  alt=""
                  class="rec-cover"
                  width={96}
                  densities={[1.5, 2]}
                  loading="lazy"
                />
              ) : (
                <Icon name={item.icon} size={32} />
              )}
            </div>
            <div class="rec-body">
              <span class="rec-badge">{copy.gear[item.key]?.badge}</span>
              <h3>{item.title}</h3>
              <p class="rec-description">{copy.gear[item.key]?.description}</p>
              <span class="rec-cta">
                {copy.cta}
                <Icon name="arrow-right" size={16} />
              </span>
              <small class="rec-paid">{copy.paid}</small>
            </div>
          </a>
        ))
      }
      {
        books.map((book) => (
          <a
            class="rec-card"
            href={book.link}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            data-monetization="affiliate"
            data-placement={placement}
            data-item={book.key}
          >
            <div class="rec-cover-wrap">
              {book.cover && imageMap[book.cover] ? (
                <Image
                  src={imageMap[book.cover]}
                  alt=""
                  class="rec-cover rec-cover--book"
                  width={96}
                  densities={[1.5, 2]}
                  loading="lazy"
                />
              ) : (
                <Icon name="book-open" size={32} />
              )}
            </div>
            <div class="rec-body">
              <span class="rec-badge">{copy.books[book.key]?.badge}</span>
              <h3>{book.title}</h3>
              {book.author && <p class="rec-author">{book.author}</p>}
              <p class="rec-description">{copy.books[book.key]?.description}</p>
              <div class="rec-ctas">
                <span class="rec-cta">
                  {copy.cta}
                  <Icon name="arrow-right" size={16} />
                </span>
                {book.kindleLink && (
                  <span class="rec-cta rec-cta--secondary">
                    {copy.kindle}
                    <Icon name="arrow-right" size={16} />
                  </span>
                )}
              </div>
              <small class="rec-paid">{copy.paid}</small>
            </div>
          </a>
        ))
      }
    </div>

    <p class="recs-affiliate">
      <Icon name="book-open" size={13} />
      {copy.disclosure}
    </p>

    <div class="recs-support">
      <span>{copy.supportPrompt}</span>
      <a
        href="https://buymeacoffee.com/jramosg"
        target="_blank"
        rel="noopener noreferrer"
        data-monetization="support"
        data-placement={`books-${placement}`}
        data-item="buy-me-a-coffee"
      >
        {copy.supportCta}
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</section>

<style>
  .recs-section {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }

  .recs-section--plan {
    margin-top: var(--space-16);
    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(239, 68, 68, 0.11),
        transparent 48%
      ),
      var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
  }

  .recs-container {
    max-width: 920px;
  }

  .recs-head {
    max-width: 680px;
    margin: 0 auto var(--space-10);
    text-align: center;
  }

  .recs-eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .section-title {
    margin-bottom: var(--space-3);
  }

  .recs-subtitle {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .recs-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 720px) {
    .recs-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .rec-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
    min-width: 0;
    padding: var(--space-5);
    color: inherit;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    text-decoration: none;
    transition:
      transform var(--transition-base),
      border-color var(--transition-base),
      background var(--transition-base),
      box-shadow var(--transition-base);
  }

  .rec-card:hover,
  .rec-card:focus-visible {
    color: inherit;
    background: var(--color-surface-hover);
    border-color: rgba(239, 68, 68, 0.45);
    box-shadow: var(--shadow-lg);
    transform: translateY(-3px);
  }

  .rec-card:focus-visible {
    outline: 3px solid rgba(239, 68, 68, 0.32);
    outline-offset: 3px;
  }

  .rec-cover-wrap {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .rec-cover {
    width: 96px;
    height: 96px;
    object-fit: contain;
    border-radius: var(--radius-md);
    transition: transform var(--transition-base);
  }

  .rec-cover--book {
    box-shadow: var(--shadow-lg);
  }

  .rec-card:hover .rec-cover {
    transform: rotate(-1deg) scale(1.025);
  }

  .rec-body {
    min-width: 0;
  }

  .rec-badge {
    display: inline-flex;
    margin-bottom: var(--space-2);
    padding: 0.2rem 0.5rem;
    color: #fecaca;
    background: rgba(239, 68, 68, 0.13);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.68rem;
    font-weight: var(--font-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .rec-card h3 {
    margin-bottom: var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .rec-author,
  .rec-description {
    font-size: var(--text-sm);
  }

  .rec-author {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }

  .rec-description {
    margin: 0 0 var(--space-4);
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .rec-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .rec-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
  }

  .rec-cta--secondary {
    color: var(--color-text-secondary);
  }

  .rec-card:hover .rec-cta :global(svg) {
    transform: translateX(3px);
  }

  .rec-cta :global(svg) {
    transition: transform var(--transition-base);
  }

  .rec-paid {
    display: block;
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: 0.65rem;
  }

  .recs-affiliate {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    max-width: 660px;
    margin: var(--space-6) auto 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .recs-affiliate :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .recs-support {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .recs-support a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-weight: var(--font-bold);
  }

  @media (max-width: 460px) {
    .rec-card {
      grid-template-columns: 72px 1fr;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .rec-cover-wrap {
      width: 72px;
      height: 72px;
    }

    .rec-cover {
      width: 72px;
      height: 72px;
    }

    .recs-section--plan {
      margin-right: calc(var(--space-4) * -1);
      margin-left: calc(var(--space-4) * -1);
      border-right: 0;
      border-left: 0;
      border-radius: 0;
    }
  }
</style>
