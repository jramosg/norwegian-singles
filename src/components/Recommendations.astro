---
/**
 * Gear and reading recommendations shown after users understand
 * the product value. Links use Global Earning (single link per product).
 */

import { Image } from 'astro:assets';
import type { Locale } from '../types';
import { gear, books } from '../lib/affiliate';
import Icon from './Icon.astro';

import coospoHrm from '../assets/coospo-hrm.jpg';
import corosHrm from '../assets/coros-hrm.jpg';
