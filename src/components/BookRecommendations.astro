---
/**
 * Book Recommendations Component
 *
 * Affiliate-linked book recommendations. Each card is a single clickable link.
 * Links are marketplace-aware (see src/lib/affiliate.ts) and labelled as
 * affiliate links per FTC/Amazon disclosure requirements.
 */

import { Image } from 'astro:assets';
import type { Locale } from '../types';
import { useTranslations } from '../i18n/ui';
import { books, amazonUrl } from '../lib/affiliate';
import Icon from './Icon.astro';

import nsmCover from '../assets/book-nsm.jpg';
import bakkenCover from '../assets/book-bakken.jpg';

const coverMap: Record<string, ImageMetadata> = {
  '/book-nsm.jpg': nsmCover,
  '/book-bakken.jpg': bakkenCover,
};

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="books-section section">
  <div class="container">
    <div class="books-head">
      <h2 class="section-title">{t('books.title')}</h2>
      <p class="books-subtitle">{t('books.subtitle')}</p>
    </div>

    <div class="books-grid">
      {
        books.map((book) => (
          <a
            class="book-card"
            href={amazonUrl(book.asin, locale)}
            target="_blank"
            rel="sponsored nofollow noopener"
          >
            <div class="book-cover-wrap">
              {book.cover && coverMap[book.cover] ? (
                <Image
                  src={coverMap[book.cover]}
                  alt={book.title}
                  class="book-cover"
                  width={88}
                  densities={[1.5, 2]}
                  loading="lazy"
                />
              ) : (
                <Icon name="book-open" size={32} />
              )}
            </div>
            <div class="book-body">
              <h3>{book.title}</h3>
              {book.author && <p class="book-author">{book.author}</p>}
              <span class="book-cta">
                {t('books.cta')}
                <Icon name="arrow-right" size={16} />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <p class="books-affiliate">
      <Icon name="book-open" size={13} />
      {t('books.affiliate')}
    </p>
  </div>
</section>

<style>
  .books-section {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }

  .books-head {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .section-title {
    margin-bottom: var(--space-2);
  }

  .books-subtitle {
    color: var(--color-text-secondary);
    margin: 0;
  }

  .books-grid {
    display: grid;
    gap: var(--space-5);
    max-width: 780px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .books-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .book-card {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
  }

  .book-card:hover {
    border-color: var(--color-border-accent);
    background: var(--color-surface-hover);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .book-cover-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
  }

  .book-cover {
    width: 88px;
    height: auto;
    border-radius: var(--radius-md);
    object-fit: cover;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base);
  }

  .book-card:hover .book-cover {
    transform: scale(1.04) rotate(-1deg);
  }

  .book-body {
    min-width: 0;
  }

  .book-card h3 {
    font-size: var(--text-lg);
    line-height: 1.25;
    margin-bottom: var(--space-1);
  }

  .book-author {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-3);
  }

  .book-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-accent-primary);
  }

  .book-cta :global(svg) {
    transition: transform var(--transition-base);
  }

  .book-card:hover .book-cta :global(svg) {
    transform: translateX(3px);
  }

  .books-affiliate {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
