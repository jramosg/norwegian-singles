---
/**
 * Icon — inline Lucide SVG icons (https://lucide.dev, ISC license).
 *
 * Stroke-based icons that inherit `currentColor` and scale via the `size` prop.
 * Glyph data lives in src/lib/icons.ts.
 */

import { iconPaths, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={iconPaths[name]}
/>
