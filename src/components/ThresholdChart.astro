---
/**
 * The signature graphic: one sub-threshold session (5 x 6 min, 60 s
 * recoveries). Effort rises toward the red threshold line on every rep and
 * never crosses it. Drawn by GSAP on load (see lib/motion.ts); static
 * when motion is reduced or JavaScript is off.
 */
interface Props {
  label?: string;
  class?: string;
}

const { label = 'Threshold', class: className } = Astro.props;

const W = 1200;
const BASE = 196;
const LINE = 64;

// Build the effort curve: warm-up ramp, 5 reps, cool-down.
const reps = 5;
const start = 120;
const end = W - 110;
const slot = (end - start) / reps;
const work = slot * 0.82;
const peaks = [96, 90, 86, 82, 79];

let d = `M0 ${BASE} C 50 ${BASE}, 80 ${BASE - 26}, ${start} ${BASE - 40}`;
for (let i = 0; i < reps; i++) {
  const x0 = start + i * slot;
  const x1 = x0 + work;
  const x2 = x0 + slot;
  const peak = peaks[i];
  const trough = 150 - i * 3;
  d += ` C ${x0 + work * 0.25} ${peak + 34}, ${x0 + work * 0.55} ${peak + 4},`;
  d += ` ${x1} ${peak}`;
  d += ` C ${x1 + 14} ${peak + 6}, ${x2 - 22} ${trough}, ${x2} ${trough - 4}`;
}
d += ` C ${end + 40} ${BASE - 30}, ${W - 30} ${BASE}, ${W} ${BASE}`;

const ticks = Array.from({ length: 25 }, (_, i) => (i * W) / 24);
---

<div
  class:list={['threshold-chart', className]}
  style={`--line-y: ${(LINE / 220) * 100}%`}
  data-threshold-chart
>
  <svg
    viewBox={`0 0 ${W} 220`}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <g class="tc-ticks">
      {ticks.map((x) => <line x1={x} x2={x} y1={BASE + 8} y2={BASE + 16} />)}
    </g>
    <line
      class="tc-line"
      x1="0"
      x2={W}
      y1={LINE}
      y2={LINE}
      vector-effect="non-scaling-stroke"
      data-draw="line"></line>
    <path
      class="tc-curve"
      d={d}
      vector-effect="non-scaling-stroke"
      data-draw="curve"></path>
  </svg>
  <span class="tc-label" aria-hidden="true">{label}</span>
</div>

<style>
  .threshold-chart {
    position: relative;
    height: clamp(7rem, 14vw, 12rem);
  }

  .threshold-chart svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tc-ticks line {
    stroke: rgba(13, 34, 54, 0.18);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .tc-line {
    stroke: var(--flag);
    stroke-width: 2;
  }

  .tc-curve {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tc-label {
    position: absolute;
    left: 0;
    top: var(--line-y);
    transform: translateY(calc(-100% - 0.4rem));
    color: var(--flag);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1;
  }

  /* Hidden until motion.ts reveals it, only once JS confirms motion. */
  :global(html.motion-ok) .threshold-chart [data-draw] {
    clip-path: inset(-10% 100% -10% 0);
  }

  :global(html.motion-ok) .threshold-chart .tc-label {
    opacity: 0;
  }
</style>
