---
/**
 * Compact gear pick shown right after a generated plan: one watch for
 * pacing the reps, one strap for keeping easy days easy.
 */
import Icon from './Icon.astro';
import { gear } from '../lib/affiliate';
import type { Locale } from '../types';

interface Props {
  locale: Locale;
  placement: string;
}

const { locale, placement } = Astro.props;

const copy = {
  en: {
    title: 'Run these paces with the right tools',
    text: 'Pace the reps by GPS and keep easy days easy by heart rate.',
    watch: 'GPS watch for pacing the reps',
    strap: 'Heart rate strap for easy days',
    paid: 'Paid links',
  },
  es: {
    title: 'Corre estos ritmos con las herramientas adecuadas',
    text: 'Controla las series con el GPS y mantén suaves los días fáciles con la frecuencia cardiaca.',
    watch: 'Reloj GPS para clavar las series',
    strap: 'Banda de pulso para los días fáciles',
    paid: 'Enlaces remunerados',
  },
  ko: {
    title: '알맞은 장비로 이 페이스를 달리세요',
    text: 'GPS로 반복 페이스를 맞추고, 이지 데이는 심박으로 편하게 유지하세요.',
    watch: '반복 페이스용 GPS 시계',
    strap: '이지 데이용 심박 스트랩',
    paid: '유료 링크',
  },
  de: {
    title: 'Lauf diese Paces mit der richtigen Ausrüstung',
    text: 'Steuere die Intervalle per GPS und halte lockere Tage über die Herzfrequenz locker.',
    watch: 'GPS-Uhr für das Intervall-Tempo',
    strap: 'Brustgurt für lockere Tage',
    paid: 'Bezahlte Links',
  },
  fr: {
    title: 'Cours ces allures avec le bon matériel',
    text: 'Gère les répétitions au GPS et garde les jours faciles faciles grâce à la fréquence cardiaque.',
    watch: 'Montre GPS pour tenir l’allure',
    strap: 'Ceinture cardio pour les jours faciles',
    paid: 'Liens rémunérés',
  },
  it: {
    title: 'Corri questi ritmi con gli strumenti giusti',
    text: 'Gestisci le ripetute con il GPS e tieni lenti i giorni facili con la frequenza cardiaca.',
    watch: 'Orologio GPS per il ritmo delle ripetute',
    strap: 'Fascia cardio per i giorni facili',
    paid: 'Link pubblicitari',
  },
  'pt-BR': {
    title: 'Corra estes ritmos com as ferramentas certas',
    text: 'Controle os tiros pelo GPS e mantenha os dias leves realmente leves pela frequência cardíaca.',
    watch: 'Relógio GPS para acertar os tiros',
    strap: 'Cinta cardíaca para os dias leves',
    paid: 'Links de afiliado',
  },
}[locale];

const picks = [
  { item: gear.find((g) => g.key === 'coros-pace4')!, role: copy.watch },
  { item: gear.find((g) => g.key === 'polar-h10')!, role: copy.strap },
];
---

<aside class="gear-strip" aria-label={copy.title}>
  <div class="gear-strip-copy">
    <p class="gear-strip-title">{copy.title}</p>
    <p class="gear-strip-text">{copy.text}</p>
  </div>
  <ul class="gear-strip-picks">
    {
      picks.map(({ item, role }) => (
        <li>
          <a
            href={item.link}
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            data-monetization="affiliate"
            data-placement={placement}
            data-item={item.key}
          >
            <span class="gear-strip-icon" aria-hidden="true">
              <Icon name={item.icon} size={20} />
            </span>
            <span>
              <strong>{item.title}</strong>
              <em>{role}</em>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <small class="gear-strip-paid">{copy.paid}</small>
</aside>

<style>
  .gear-strip {
    display: grid;
    gap: var(--space-4) var(--space-8);
    padding: var(--space-6);
    background: var(--mist);
    border-radius: var(--radius-2xl);
  }

  @media (min-width: 860px) {
    .gear-strip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
      align-items: center;
    }

    .gear-strip-paid {
      grid-column: 2;
    }
  }

  .gear-strip-title {
    margin-bottom: var(--space-1);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    line-height: 1.2;
  }

  .gear-strip-text {
    margin: 0;
    font-size: var(--text-sm);
  }

  .gear-strip-picks {
    display: grid;
    gap: var(--space-2);
    list-style: none;
  }

  @media (min-width: 560px) {
    .gear-strip-picks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .gear-strip-picks a {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    height: 100%;
    padding: var(--space-3) var(--space-4);
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition: border-color var(--transition-fast);
  }

  .gear-strip-picks a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .gear-strip-icon {
    display: grid;
    flex: 0 0 2.5rem;
    place-items: center;
    height: 2.5rem;
    background: var(--mist);
    border-radius: var(--radius-full);
  }

  .gear-strip-picks strong,
  .gear-strip-picks em {
    display: block;
  }

  .gear-strip-picks strong {
    font-weight: 600;
  }

  .gear-strip-picks em {
    color: var(--slate);
    font-size: var(--text-xs);
    font-style: normal;
  }

  .gear-strip-paid {
    color: var(--slate);
    font-size: 0.7rem;
  }
</style>
