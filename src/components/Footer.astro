---
import type { Locale } from '../types';
import { useTranslations } from '../i18n/ui';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <Logo href={`/${locale}`} />
        <p class="footer-tagline">{t('footer.credit')}</p>
      </div>

      <div class="footer-principles">
        <p class="footer-heading">{t('method.title')}</p>
        <ul class="principles-list">
          <li>{t('method.principle1.title')}</li>
          <li>{t('method.principle2.title')}</li>
          <li>{t('method.principle3.title')}</li>
          <li>{t('method.principle4.title')}</li>
        </ul>
      </div>

      <div class="footer-support">
        <p class="footer-heading">{t('footer.support')}</p>
        <p class="support-text">{t('footer.supportTagline')}</p>
        <a
          href="https://buymeacoffee.com/jramosg"
          target="_blank"
          rel="noopener noreferrer"
          class="support-button"
          data-monetization="support"
          data-placement="footer"
          data-item="buy-me-a-coffee"
        >
          {t('support.floatingButton')}
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="disclaimer">{t('footer.disclaimer')}</p>
      <div class="footer-legal">
        <p class="copyright">
          © {new Date().getFullYear()} Norwegian Singles. {t('footer.rights')}
        </p>
        <p class="developer">
          {t('footer.dev')}
          <a
            href="https://jonramos.dev"
            target="_blank"
            rel="noopener noreferrer">Jonramos</a
          >
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin: var(--space-16) clamp(0.5rem, 1.5vw, 1.25rem)
      clamp(0.5rem, 1.5vw, 1.25rem);
    padding: clamp(3rem, 6vw, 5rem) 0 var(--space-8);
    color: #dbe5ee;
    background: var(--ink);
    border-radius: var(--radius-panel);
  }

  .footer-content {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1.3fr 1fr 1.2fr;
    }
  }

  .footer :global(.logo) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-4);
    color: #fff;
  }

  .footer :global(.logo-mark) {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke-linecap: round;
    stroke-width: 2.25;
  }

  .footer :global(.logo-line) {
    stroke: #ff4d5e;
  }

  .footer :global(.logo-curve) {
    stroke: #fff;
  }

  .footer :global(.logo-text) {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
  }

  .footer-tagline,
  .support-text {
    max-width: 34ch;
    color: #a9bacb;
    font-size: var(--text-sm);
  }

  .footer-heading {
    margin-bottom: var(--space-4);
    color: #fff;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
  }

  .principles-list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    color: #c4d2df;
    font-size: var(--text-sm);
  }

  .principles-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .principles-list li::before {
    content: '';
    flex: 0 0 0.9rem;
    height: 1.5px;
    background: #ff4d5e;
  }

  .support-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: 0.8rem 1.35rem;
    color: var(--ink);
    background: #fff;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    transition: transform var(--transition-fast);
  }

  .support-button:hover {
    color: var(--ink);
    transform: translateY(-1px);
  }

  .footer-bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .disclaimer {
    max-width: 72ch;
    margin-bottom: var(--space-4);
    color: #8ea1b4;
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .footer-legal p {
    margin: 0;
    color: #8ea1b4;
    font-size: var(--text-xs);
  }

  .footer-legal a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
