---
/** Wordmark with the threshold mark: a red line above an effort curve. */
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a {href} class:list={['logo', className]} aria-label="Norwegian Singles">
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <line x1="3" y1="11" x2="29" y2="11" class="logo-line"></line>
    <path
      d="M3 27 C 9 27, 10 16, 14 16 S 19 24, 22 20 S 26 14, 29 14"
      class="logo-curve"></path>
  </svg>
  <span class="logo-text">Norwegian Singles</span>
</a>
