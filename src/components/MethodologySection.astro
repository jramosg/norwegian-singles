---
/**
 * Methodology Section Component
 *
 * Displays Norwegian Singles principles and methodology notes
 * Used in landing pages and plan pages
 */

import type { Locale } from '../types';
import { useTranslations, type TranslationKey } from '../i18n/ui';
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  locale: Locale;
  includePrinciples?: boolean;
  includeNotes?: boolean;
}

const { locale, includePrinciples = true, includeNotes = true } = Astro.props;
const t = useTranslations(locale);

const principles: {
  icon: IconName;
  title: TranslationKey;
  desc: TranslationKey;
}[] = [
  {
    icon: 'zap',
    title: 'method.principle1.title',
    desc: 'method.principle1.desc',
  },
  {
    icon: 'target',
    title: 'method.principle2.title',
    desc: 'method.principle2.desc',
  },
  {
    icon: 'timer',
    title: 'method.principle3.title',
    desc: 'method.principle3.desc',
  },
  {
    icon: 'repeat',
    title: 'method.principle4.title',
    desc: 'method.principle4.desc',
  },
];

const notesList = {
  en: [
    'Short recoveries (60s) to maintain elevated lactate state',
    'Recovery: standing, walking or very easy jog',
    'Quality work = 20-25% of weekly volume',
    'Easy runs: extremely easy, ≤70% max HR',
  ],
  es: [
    'Recuperaciones cortas (60s) para mantener el lactato elevado',
    'Recuperación: de pie, caminando o trote muy suave',
    'Trabajo de calidad = 20-25% del volumen semanal',
    'Rodajes fáciles: muy suaves, ≤70% FC máx',
  ],
  ko: [
    '짧은 회복(60초)으로 젖산이 약간 높은 상태 유지',
    '회복은 서 있기, 걷기 또는 아주 가벼운 조깅',
    '품질 훈련은 주간 볼륨의 20-25%',
    '이지런은 매우 편하게, 최대 심박의 70% 이하',
  ],
}[locale];

const notesTitle = {
  en: 'Methodology Notes',
  es: 'Notas metodológicas',
  ko: '훈련법 메모',
}[locale];
---

<div class="methodology-section">
  {
    includePrinciples && (
      <section class="method-section section">
        <div class="container">
          <h2 class="section-title">{t('method.title')}</h2>

          <div class="principles-grid">
            {principles.map((principle) => (
              <article class="principle-card">
                <div class="principle-icon">
                  <Icon name={principle.icon} size={24} />
                </div>
                <h3>{t(principle.title)}</h3>
                <p>{t(principle.desc)}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    includeNotes && (
      <section class="note-section section">
        <div class="container">
          <div class="note">
            <h4 class="note-title">📋 {notesTitle}</h4>
            <ul class="note-list">
              {notesList.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }
</div>

<style>
  .section-title {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  .principles-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .principle-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-8) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .principle-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(239, 68, 68, 0.08),
      transparent 70%
    );
    opacity: 0;
    transition: opacity var(--transition-base);
    pointer-events: none;
  }

  .principle-card:hover {
    border-color: var(--color-border-accent);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .principle-card:hover::before {
    opacity: 1;
  }

  .principle-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-5);
    color: var(--color-accent-primary);
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    border-radius: var(--radius-lg);
    transition:
      transform var(--transition-base),
      background var(--transition-base);
  }

  .principle-card:hover .principle-icon {
    transform: scale(1.08);
    background: rgba(239, 68, 68, 0.16);
  }

  .principle-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .principle-card p {
    font-size: var(--text-sm);
    margin: 0;
    color: var(--color-text-secondary);
  }

  .note-section .note {
    max-width: 600px;
    margin: 0 auto;
  }

  .note-title {
    margin-bottom: var(--space-4);
  }

  .note-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .note-list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-4);
    position: relative;
  }

  .note-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent-primary);
  }
</style>
