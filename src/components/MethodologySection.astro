---
/**
 * Methodology Section Component
 *
 * Displays Norwegian Singles principles and methodology notes
 * Used in landing pages and plan pages
 */

import type { Locale } from '../types';
import { useTranslations, type TranslationKey } from '../i18n/ui';

interface Props {
  locale: Locale;
  includePrinciples?: boolean;
  includeNotes?: boolean;
}

const { locale, includePrinciples = true, includeNotes = true } = Astro.props;
const t = useTranslations(locale);

const principles: {
  title: TranslationKey;
  desc: TranslationKey;
}[] = [
  {
    title: 'method.principle1.title',
    desc: 'method.principle1.desc',
  },
  {
    title: 'method.principle2.title',
    desc: 'method.principle2.desc',
  },
  {
    title: 'method.principle3.title',
    desc: 'method.principle3.desc',
  },
  {
    title: 'method.principle4.title',
    desc: 'method.principle4.desc',
  },
];

const notesList = {
  en: [
    'Short recoveries (60s) to maintain elevated lactate state',
    'Recovery: standing, walking or very easy jog',
    'Quality work = 20-25% of weekly volume',
    'Easy runs: extremely easy, ≤70% max HR',
  ],
  it: [
    'Recuperi brevi (60 s) per mantenere elevato il lattato',
    'Recupero da fermo, camminando o correndo molto lentamente',
    'Lavoro di qualità = 20–25% del volume settimanale',
    'Corse lente: molto facili, ≤70% della FC massima',
  ],
  'pt-BR': [
    'Recuperações curtas (60 s) para manter o lactato elevado',
    'Recuperação parado, caminhando ou trotando bem leve',
    'Trabalho de qualidade = 20–25% do volume semanal',
    'Rodagens leves: bem leves, ≤70% da FC máxima',
  ],
  es: [
    'Recuperaciones cortas (60s) para mantener el lactato elevado',
    'Recuperación: de pie, caminando o trote muy suave',
    'Trabajo de calidad = 20-25% del volumen semanal',
    'Rodajes fáciles: muy suaves, ≤70% FC máx',
  ],
  ko: [
    '짧은 회복(60초)으로 젖산이 약간 높은 상태 유지',
    '회복은 서 있기, 걷기 또는 아주 가벼운 조깅',
    '품질 훈련은 주간 볼륨의 20-25%',
    '이지런은 매우 편하게, 최대 심박의 70% 이하',
  ],
  de: [
    'Kurze Pausen (60 s), um den leicht erhöhten Laktatzustand zu halten',
    'Pause: stehen, gehen oder sehr lockerer Trab',
    'Qualitätsarbeit = 20-25 % des Wochenumfangs',
    'Lockere Läufe: extrem locker, ≤70 % der maximalen HF',
  ],
  fr: [
    'Récupérations courtes (60 s) pour garder un lactate légèrement élevé',
    'Récupération : debout, en marchant ou en trottinant très doucement',
    'Travail de qualité = 20-25 % du volume hebdomadaire',
    'Footings faciles : très lents, ≤70 % de la FC max',
  ],
}[locale];

const notesTitle = {
  en: 'Methodology Notes',
  it: 'Note sul metodo',
  'pt-BR': 'Orientações sobre o método',
  es: 'Notas metodológicas',
  ko: '훈련법 메모',
  de: 'Methodik-Hinweise',
  fr: 'Notes méthodologiques',
}[locale];

const guideLink = {
  en: {
    href: '/en/nsm-training-method/',
    label: 'Read the complete NSM method guide',
  },
  it: {
    href: '/it/metodo-allenamento-nsm/',
    label: 'Leggi la guida completa al metodo NSM',
  },
  'pt-BR': {
    href: '/pt-BR/metodo-treino-nsm/',
    label: 'Leia o guia completo do método NSM',
  },
  es: {
    href: '/es/entrenamiento-nsm/',
    label: 'Leer la guía completa del método NSM',
  },
  ko: {
    href: '/ko/nsm-training/',
    label: 'NSM 훈련법 전체 가이드 보기',
  },
  de: {
    href: '/de/nsm-trainingsmethode/',
    label: 'Den vollständigen NSM-Leitfaden lesen',
  },
  fr: {
    href: '/fr/methode-entrainement-nsm/',
    label: 'Lire le guide complet de la méthode NSM',
  },
}[locale];
const isGuidePage =
  Astro.url.pathname.replace(/\/$/, '') === guideLink.href.replace(/\/$/, '');
---

<div class="methodology-section">
  {
    includePrinciples && (
      <section class="manifesto" aria-labelledby="manifesto-title">
        <div class="container manifesto-inner">
          <h2 id="manifesto-title" class="manifesto-title">
            {t('method.title')}
          </h2>
          <p class="manifesto-text" data-reveal-words>
            {principles.map((p) => `${t(p.title)}. ${t(p.desc)}`).join(' ')}
          </p>
          {!isGuidePage && (
            <a class="manifesto-link" href={guideLink.href}>
              {guideLink.label}
            </a>
          )}
        </div>
      </section>
    )
  }

  {
    includeNotes && (
      <section class="notes" aria-labelledby="notes-title">
        <div class="container notes-inner">
          <h2 id="notes-title" class="notes-title">
            {notesTitle}
          </h2>
          <ul class="notes-list">
            {notesList.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</div>

<style>
  .manifesto {
    padding: clamp(5rem, 12vw, 10rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .manifesto-inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .manifesto-title {
    margin-bottom: var(--space-8);
    color: var(--slate);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: 0;
  }

  .manifesto-text {
    max-width: 24ch;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.1rem + 3.4vw, 4rem);
    font-weight: 450;
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .manifesto-text :global(.rw) {
    display: inline-block;
    will-change: opacity, filter;
  }

  .manifesto-link {
    margin-top: var(--space-10);
    padding: 0.85rem 1.5rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-full);
    font-weight: 500;
    transition: border-color var(--transition-fast);
  }

  .manifesto-link:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .notes {
    padding-bottom: var(--space-16);
  }

  .notes-inner {
    max-width: var(--container-narrow);
  }

  .notes-title {
    margin-bottom: var(--space-4);
    font-size: var(--text-2xl);
  }

  .notes-list {
    display: grid;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .notes-list li {
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .notes-list li::before {
    content: '';
    flex: 0 0 1.25rem;
    height: 2px;
    background: var(--flag);
    transform: translateY(-0.3em);
  }
</style>
