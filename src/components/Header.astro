---
import type { Locale } from '../types';
import {
  getPathInLocale,
  languageLabels,
  locales,
  useTranslations,
} from '../i18n/ui';
import { getAlternateSeoPath } from '../lib/seo-pages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const localizedPath = (lang: Locale) =>
  getAlternateSeoPath(currentPath, locale, lang) ||
  getPathInLocale(currentPath, lang);
const currentLanguage = languageLabels[locale];
const languageMenuLabel = {
  en: 'Language',
  es: 'Idioma',
  ko: '언어',
  de: 'Sprache',
  fr: 'Langue',
}[locale];
---

<header class="header glass">
  <div class="header-container container">
    <a href={`/${locale}`} class="logo">
      <span class="logo-icon">🇳🇴</span>
      <span class="logo-text">NS</span>
    </a>

    <nav class="nav">
      <a href={`/${locale}`} class="nav-link">{t('nav.home')}</a>
      <a href={`/${locale}/plan`} class="nav-link">{t('nav.plan')}</a>
    </nav>

    <div class="header-actions">
      <details class="lang-menu">
        <summary class="lang-trigger" aria-label="Change language">
          <span class="lang-trigger-code">{currentLanguage.code}</span>
          <span class="lang-trigger-name">{currentLanguage.nativeName}</span>
          <span class="lang-trigger-chevron" aria-hidden="true">⌄</span>
        </summary>
        <div class="lang-options">
          {
            locales.map((lang) => {
              const label = languageLabels[lang];
              return (
                <a
                  href={localizedPath(lang)}
                  class:list={['lang-option', { 'is-active': lang === locale }]}
                  aria-current={lang === locale ? 'page' : undefined}
                  data-lang-target={lang}
                >
                  <span class="lang-option-code">{label.code}</span>
                  <span>
                    <strong>{label.nativeName}</strong>
                    <em>{label.name}</em>
                  </span>
                </a>
              );
            })
          }
        </div>
      </details>

      <button
        class="mobile-menu-btn btn-icon btn-ghost"
        aria-label="Menu"
        id="mobile-menu-toggle"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-header">
    <a href={`/${locale}`} class="logo">
      <span class="logo-icon">🇳🇴</span>
      <span class="logo-text">NS</span>
    </a>
    <button
      class="btn-icon btn-ghost"
      aria-label="Close"
      id="mobile-menu-close"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="mobile-nav">
    <a href={`/${locale}`} class="mobile-nav-link">{t('nav.home')}</a>
    <a href={`/${locale}/plan`} class="mobile-nav-link">{t('nav.plan')}</a>
  </nav>

  <div class="mobile-lang">
    <div class="mobile-lang-label">{languageMenuLabel}</div>
    <div class="mobile-lang-grid">
      {
        locales.map((lang) => {
          const label = languageLabels[lang];
          return (
            <a
              href={localizedPath(lang)}
              class:list={[
                'mobile-lang-option',
                { 'is-active': lang === locale },
              ]}
              aria-current={lang === locale ? 'page' : undefined}
              data-lang-target={lang}
            >
              <span>{label.code}</span>
              <strong>{label.nativeName}</strong>
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: var(--z-sticky);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text-primary);
  }

  .logo-icon {
    font-size: var(--text-xl);
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-bold);
    letter-spacing: -0.02em;
  }

  .nav {
    display: none;
    gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }

    .mobile-menu-btn {
      display: none;
    }
  }

  .nav-link {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang-menu {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .lang-menu {
      display: block;
    }
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 8.75rem;
    padding: 0.45rem 0.55rem 0.45rem 0.45rem;
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    list-style: none;
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast);
  }

  .lang-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-trigger:hover,
  .lang-menu[open] .lang-trigger {
    background: rgba(255, 255, 255, 0.09);
    border-color: var(--color-border-accent);
  }

  .lang-trigger-code,
  .lang-option-code,
  .mobile-lang-option span {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 1.75rem;
    color: var(--color-text-primary);
    background: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(239, 68, 68, 0.28);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
  }

  .lang-trigger-name {
    flex: 1;
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .lang-trigger-chevron {
    color: var(--color-text-muted);
    transform: translateY(-1px);
  }

  .lang-options {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    display: grid;
    gap: var(--space-1);
    width: 14rem;
    padding: var(--space-2);
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    color: var(--color-text-primary);
    border-radius: var(--radius-lg);
    text-decoration: none;
  }

  .lang-option:hover,
  .lang-option.is-active {
    background: rgba(255, 255, 255, 0.07);
  }

  .lang-option strong,
  .lang-option em {
    display: block;
    line-height: 1.2;
  }

  .lang-option strong {
    font-size: var(--text-sm);
  }

  .lang-option em {
    margin-top: 0.1rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-style: normal;
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: var(--color-bg-primary);
    padding: var(--space-4);
    transform: translateX(100%);
    transition: transform var(--transition-slow);
    display: flex;
    flex-direction: column;
  }

  .mobile-menu.is-open {
    transform: translateX(0);
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1;
  }

  .mobile-nav-link {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-lang {
    padding: var(--space-4) 0;
  }

  .mobile-lang-label {
    margin-bottom: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
  }

  .mobile-lang-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .mobile-lang-option {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    padding: var(--space-3);
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
  }

  .mobile-lang-option.is-active {
    background: rgba(239, 68, 68, 0.14);
    border-color: rgba(239, 68, 68, 0.36);
  }

  .mobile-lang-option strong {
    font-size: var(--text-sm);
  }
</style>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  });

  menuClose?.addEventListener('click', () => {
    mobileMenu?.classList.remove('is-open');
    document.body.style.overflow = '';
  });

  // Close menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });

  document.querySelectorAll('[data-lang-target]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.getAttribute('data-lang-target');
      const current = document.documentElement.dataset.locale;
      if (!target || target === current) return;

      const analyticsWindow = window as Window & {
        dataLayer?: Record<string, string | undefined>[];
      };
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({
        event: 'language_change',
        from: current,
        to: target,
        path: window.location.pathname,
      });
    });
  });
</script>
