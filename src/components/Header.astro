---
import type { Locale } from '../types';
import {
  getPathInLocale,
  languageLabels,
  locales,
  useTranslations,
} from '../i18n/ui';
import { getAlternateSeoPath } from '../lib/seo-pages';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const currentPath = Astro.url.pathname;

const localizedPath = (lang: Locale) =>
  getAlternateSeoPath(currentPath, locale, lang) ||
  getPathInLocale(currentPath, lang);
const currentLanguage = languageLabels[locale];
const languageMenuLabel = {
  en: 'Language',
  it: 'Lingua',
  'pt-BR': 'Idioma',
  es: 'Idioma',
  ko: '언어',
  de: 'Sprache',
  fr: 'Langue',
}[locale];
---

<header class="header" id="site-header">
  <div class="header-container container">
    <Logo href={`/${locale}`} />

    <nav class="nav" aria-label="Main">
      <a href={`/${locale}`} class="nav-link">{t('nav.home')}</a>
      <a href={`/${locale}/plan`} class="nav-link">{t('nav.plan')}</a>
    </nav>

    <div class="header-actions">
      <details class="lang-menu">
        <summary class="lang-trigger" aria-label={t('nav.changeLanguage')}>
          <span class="lang-trigger-code">{currentLanguage.code}</span>
          <span class="lang-trigger-name">{currentLanguage.nativeName}</span>
          <svg
            class="lang-trigger-chevron"
            viewBox="0 0 12 12"
            aria-hidden="true"
          >
            <path d="M2.5 4.5 6 8l3.5-3.5"></path>
          </svg>
        </summary>
        <div class="lang-options">
          {
            locales.map((lang) => {
              const label = languageLabels[lang];
              return (
                <a
                  href={localizedPath(lang)}
                  class:list={['lang-option', { 'is-active': lang === locale }]}
                  aria-current={lang === locale ? 'page' : undefined}
                  data-lang-target={lang}
                >
                  <span class="lang-option-code">{label.code}</span>
                  <span>
                    <strong>{label.nativeName}</strong>
                    <em>{label.name}</em>
                  </span>
                </a>
              );
            })
          }
        </div>
      </details>

      <button
        class="mobile-menu-btn"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-toggle"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-header">
    <Logo href={`/${locale}`} />
    <button
      class="mobile-menu-close"
      aria-label={t('nav.closeMenu')}
      id="mobile-menu-close"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
  </div>

  <nav class="mobile-nav" aria-label="Main">
    <a href={`/${locale}`} class="mobile-nav-link">{t('nav.home')}</a>
    <a href={`/${locale}/plan`} class="mobile-nav-link">{t('nav.plan')}</a>
  </nav>

  <div class="mobile-lang">
    <p class="mobile-lang-label">{languageMenuLabel}</p>
    <div class="mobile-lang-grid">
      {
        locales.map((lang) => {
          const label = languageLabels[lang];
          return (
            <a
              href={localizedPath(lang)}
              class:list={[
                'mobile-lang-option',
                { 'is-active': lang === locale },
              ]}
              aria-current={lang === locale ? 'page' : undefined}
              data-lang-target={lang}
            >
              <span>{label.code}</span>
              <strong>{label.nativeName}</strong>
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    height: var(--header-height);
    z-index: var(--z-sticky);
    background: rgba(242, 245, 248, 0.94);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--transition-base),
      background var(--transition-base);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: rgba(242, 245, 248, 0.82);
      backdrop-filter: saturate(1.4) blur(14px);
      -webkit-backdrop-filter: saturate(1.4) blur(14px);
    }
  }

  .header.is-scrolled {
    border-bottom-color: var(--color-border);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: 100%;
  }

  .header :global(.logo),
  .mobile-menu :global(.logo) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }

  .header :global(.logo:hover),
  .mobile-menu :global(.logo:hover) {
    color: var(--ink);
  }

  .header :global(.logo-mark),
  .mobile-menu :global(.logo-mark) {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke-linecap: round;
  }

  .header :global(.logo-line),
  .mobile-menu :global(.logo-line) {
    stroke: var(--flag);
    stroke-width: 2.25;
  }

  .header :global(.logo-curve),
  .mobile-menu :global(.logo-curve) {
    stroke: var(--ink);
    stroke-width: 2.25;
  }

  .header :global(.logo-text),
  .mobile-menu :global(.logo-text) {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav {
    display: none;
    gap: var(--space-1);
    margin-right: auto;
    margin-left: var(--space-6);
  }

  .nav-link {
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .nav-link:hover {
    color: var(--ink);
    background: rgba(13, 34, 54, 0.06);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .lang-menu {
    display: none;
    position: relative;
  }

  @media (min-width: 768px) {
    .nav,
    .lang-menu {
      display: flex;
    }

    .mobile-menu-btn {
      display: none !important;
    }
  }

  .lang-trigger {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
    list-style: none;
    transition: border-color var(--transition-fast);
  }

  .lang-trigger::-webkit-details-marker {
    display: none;
  }

  .lang-trigger:hover,
  .lang-menu[open] .lang-trigger {
    border-color: var(--color-border-accent);
  }

  .lang-trigger-code,
  .lang-option-code,
  .mobile-lang-option span {
    display: inline-grid;
    place-items: center;
    min-width: 1.85rem;
    height: 1.85rem;
    padding-inline: 0.3rem;
    flex-shrink: 0;
    color: var(--ink);
    background: var(--mist);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .lang-trigger-name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .lang-trigger-chevron {
    width: 0.75rem;
    height: 0.75rem;
    fill: none;
    stroke: var(--slate);
    stroke-width: 1.5;
    transition: transform var(--transition-fast);
  }

  .lang-menu[open] .lang-trigger-chevron {
    transform: rotate(180deg);
  }

  .lang-options {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    display: grid;
    gap: 2px;
    width: 15rem;
    padding: var(--space-2);
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0.5rem;
    color: var(--ink);
    border-radius: var(--radius-lg);
  }

  .lang-option:hover {
    background: var(--snow);
  }

  .lang-option.is-active {
    background: var(--mist);
  }

  .lang-option strong,
  .lang-option em {
    display: block;
    line-height: 1.25;
  }

  .lang-option strong {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lang-option em {
    color: var(--slate);
    font-size: var(--text-xs);
    font-style: normal;
  }

  .mobile-menu-btn {
    display: inline-grid;
    place-content: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .mobile-menu-btn span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--ink);
    border-radius: 1px;
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: flex;
    flex-direction: column;
    padding: 0 var(--space-4) var(--space-6);
    overflow-y: auto;
    background: var(--snow);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      visibility 0s linear 200ms;
  }

  .mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base);
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    margin-bottom: var(--space-6);
  }

  .mobile-menu-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .mobile-menu-close svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.75;
    stroke-linecap: round;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .mobile-nav-link {
    padding: var(--space-4) 0;
    color: var(--ink);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
  }

  .mobile-lang {
    padding-top: var(--space-6);
  }

  .mobile-lang-label {
    margin-bottom: var(--space-3);
    color: var(--slate);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .mobile-lang-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr));
    gap: var(--space-2);
  }

  .mobile-lang-option {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .mobile-lang-option.is-active {
    border-color: var(--ink);
  }

  .mobile-lang-option strong {
    font-size: var(--text-sm);
    font-weight: 500;
  }
</style>

<script>
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const menuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  const header = document.getElementById('site-header');

  const setMenuOpen = (open: boolean) => {
    mobileMenu?.classList.toggle('is-open', open);
    menuToggle?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) menuClose?.focus();
  };

  menuToggle?.addEventListener('click', () => setMenuOpen(true));
  menuClose?.addEventListener('click', () => setMenuOpen(false));
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMenuOpen(false);
  });

  const updateHeader = () =>
    header?.classList.toggle('is-scrolled', window.scrollY > 8);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  document.querySelectorAll('[data-lang-target]').forEach((link) => {
    link.addEventListener('click', () => {
      const target = link.getAttribute('data-lang-target');
      const current = document.documentElement.dataset.locale;
      if (!target || target === current) return;

      const analyticsWindow = window as Window & {
        dataLayer?: Record<string, string | undefined>[];
      };
      analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
      analyticsWindow.dataLayer.push({
        event: 'language_change',
        from: current,
        to: target,
        path: window.location.pathname,
      });
    });
  });
</script>
