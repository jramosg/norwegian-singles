<AppLayout
  title={title || t('seo.title')}
  description={description || t('seo.description')}
  locale={locale}
  structuredData={[...(structuredData || []), faqStructuredData]}
>
  <div class="landing">
    <section class="hero" id="calculator">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="hero-kicker">Norwegian Singles Approach / Method</p>
          {
            isSeoLanding ? (
              <h1 class="hero-title">{seoHeading}</h1>
            ) : (
              <h1 class="hero-title">
                {t('hero.title')}
                <span class="hero-accent">{t('hero.titleAccent')}</span>
              </h1>
            )
          }
          {
            isSeoLanding && seoIntro ? (
              <p class="hero-subtitle" set:html={seoIntro} />
            ) : (
              <p class="hero-subtitle">{t('hero.subtitle')}</p>
            )
          }

          <ul class="proof-list" aria-label="Calculator features">
            {proofBullets.map((item) => <li>{item}</li>)}
          </ul>

          <div
            class="sample-board sample-board-desktop"
            aria-label={sample.eyebrow}
          >
            <div class="sample-head">
              <span>{sample.eyebrow}</span>
              <strong>{sample.title}</strong>
              <em>{sample.input}</em>
            </div>
            <div class="sample-days">
              {
                sample.days.map(([day, session, pace]) => (
                  <div class="sample-day">
                    <span>{day}</span>
                    <strong>{session}</strong>
                    <em>{pace}</em>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="hero-product">
          <div class="form-card card glass">
            <div class="card-header">
              <h2 class="card-title">{t('form.title')}</h2>
            </div>
            <div class="card-body">
              <TrainingForm locale={locale} client:idle />
            </div>
          </div>
        </div>

        <div
          class="sample-board sample-board-mobile"
          aria-label={sample.eyebrow}
        >
          <div class="sample-head">
            <span>{sample.eyebrow}</span>
            <strong>{sample.title}</strong>
            <em>{sample.input}</em>
          </div>
          <div class="sample-days">
            {
              sample.days.map(([day, session, pace]) => (
                <div class="sample-day">
                  <span>{day}</span>
                  <strong>{session}</strong>
                  <em>{pace}</em>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="education-section section">
      <div class="container education-container">
        <div class="education-head">
          <h2>{educationText.title}</h2>
          <p>{educationText.intro}</p>
        </div>

        <div class="education-grid">
          {
            educationText.cards.map((card) => (
              <article class="education-card">
                <h3>{card.title}</h3>
                <p>{card.text}</p>
              </article>
            ))
          }
        </div>

        <div class="next-step-panel">
          <h3>{educationText.nextTitle}</h3>
          <div class="next-step-grid">
            {
              nextStepActions.map((action) => (
                <a class="next-step-link" href={action.href}>
                  <span>{action.eyebrow}</span>
                  <strong>{action.label}</strong>
                  <em>{action.text}</em>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <MethodologySection locale={locale} />

    <Recommendations locale={locale} />

    {
      paceCard && (
        <section class="pace-card-section section">
          <div class="container pace-card-container">
            <div class="pace-card-head">
              <h2>{`${landingText.paceTitle}: ${paceCard.raceLabel}`}</h2>
              <p>{landingText.paceIntro}</p>
            </div>
            <div class="pace-grid">
              <div class="pace-cell">
                <span>{landingText.shortSubT}</span>
                <strong>{paceCard.rep3min}</strong>
                <em>{landingText.rep3}</em>
              </div>
              <div class="pace-cell">
                <span>{landingText.mediumSubT}</span>
                <strong>{paceCard.rep6min}</strong>
                <em>{landingText.rep6}</em>
              </div>
              <div class="pace-cell">
                <span>{landingText.longSubT}</span>
                <strong>{paceCard.rep10min}</strong>
                <em>{landingText.rep10}</em>
              </div>
              <div class="pace-cell">
                <span>{landingText.easyPace}</span>
                <strong>{paceCard.easy}</strong>
                <em>{landingText.easyRunning}</em>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <section class="seo-content section" id="guide">
      <div class="container seo-container">
        <h2>{seoHeading || t('seo.content.h2')}</h2>
        {
          seoIntro ? (
            <p set:html={seoIntro} />
          ) : (
            <p set:html={t('seo.content.intro')} />
          )
        }

        <h3>{t('seo.content.doubleThreshold.title')}</h3>
        <p set:html={t('seo.content.doubleThreshold.text')} />

        <h3>{t('seo.content.howItWorks.title')}</h3>
        <p set:html={t('seo.content.howItWorks.text')} />
        <ul>
          <li set:html={t('seo.content.howItWorks.rep3')} />
          <li set:html={t('seo.content.howItWorks.rep6')} />
          <li set:html={t('seo.content.howItWorks.rep10')} />
        </ul>
        <p set:html={t('seo.content.howItWorks.paces')} />

        <h3>{t('seo.content.weeklyPlans.title')}</h3>
        <p set:html={t('seo.content.weeklyPlans.text')} />

        <h3>{t('seo.content.marathon.title')}</h3>
        <p set:html={t('seo.content.marathon.text')} />

        <h3>{t('seo.content.whoIsItFor.title')}</h3>
        <p set:html={t('seo.content.whoIsItFor.text')} />
      </div>
    </section>

    <section class="faq-section section">
      <div class="container">
        <div class="section-head">
          <h2>{landingText.faqTitle}</h2>
          <p>{landingText.faqIntro}</p>
        </div>

        <div class="faq-grid">
          {
            faqs.map((faq) => (
              <article class="faq-item">
                <h3>{faq.q}</h3>
                <p>{faq.a}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="related-section section">
      <div class="container">
        <div class="section-head">
          <h2>
            {landingText.relatedTitle}
          </h2>
          <p>{landingText.relatedIntro}</p>
        </div>

        <div class="related-groups">
          {
            relatedGroups.map((group) => (
              <article class="related-group">
                <h3>{group.title}</h3>
                <div class="related-grid">
                  {group.pages.map((page) => (
                    <article class="related-link">
                      <h4>
                        <a href={`/${locale}/${page.slug}/`}>{page.h1}</a>
                      </h4>
                      <p>{page.summary}</p>
                    </article>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pace-lookup-section section">
      <div class="container">
        <div class="section-head">
          <h2>{landingText.lookupTitle}</h2>
          <p>{landingText.lookupIntro}</p>
        </div>
        <div class="pace-lookup-grid">
          {
            raceGroups.map(({ key, label }) => (
              <div class="pace-lookup-group">
                <h3 class="pace-lookup-label">{label}</h3>
                <div class="pace-lookup-times">
                  {racePagesByDistance[key].map((page) => (
                    <a
                      class="pace-lookup-time"
                      href={`/${locale}/${page.slug}/`}
                    >
                      {page.displayTime}
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</AppLayout>

<style>
  .landing {
    background:
      linear-gradient(180deg, rgba(59, 130, 246, 0.12), transparent 30rem),
      var(--color-bg-primary);
  }

  .hero {
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    padding: var(--space-10) 0 var(--space-16);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-10);
  }

  @media (min-width: 1080px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(430px, 520px);
    }
  }

  .hero-content {
    text-align: left;
  }

  .hero-kicker {
    display: inline-flex;
    margin-bottom: var(--space-4);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.28);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-title {
    max-width: 760px;
    font-size: var(--text-4xl);
    line-height: 1.05;
    margin-bottom: var(--space-4);
    letter-spacing: 0;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: var(--text-6xl);
    }
  }

  .hero-accent {
    display: block;
    background: linear-gradient(135deg, #f97316 0%, #ef4444 45%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 650px;
    margin: 0;
  }

  .proof-list {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-6) 0;
    padding: 0;
    list-style: none;
    li {
      display: flex;
      align-items: center;
      justify-content: flex-start;
    }
  }

  @media (min-width: 680px) {
    .proof-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 640px;
    }
  }

  .proof-list li {
    position: relative;
    padding: var(--space-3) var(--space-4) var(--space-3) 2.4rem;
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
  }

  .proof-list li::before {
    content: '';
    position: absolute;
    left: var(--space-4);
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    background: #22c55e;
    border-radius: 50%;
    transform: translateY(-50%);
    box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.14);
  }

  .sample-board {
    max-width: 680px;
    padding: var(--space-5);
    background: #111113;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
  }

  .sample-board-desktop {
    display: none;
  }

  @media (max-width: 1079px) {
    .sample-board-mobile {
      display: block;
    }
  }

  @media (min-width: 1080px) {
    .sample-board-desktop {
      display: block;
    }

    .sample-board-mobile {
      display: none;
    }
  }

  .sample-head {
    display: grid;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .sample-head span,
  .sample-head em {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-style: normal;
  }

  .sample-head span {
    font-weight: var(--font-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sample-head strong {
    font-size: var(--text-xl);
  }

  .sample-days {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 620px) {
    .sample-days {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sample-day {
    min-height: 7rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-3);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .sample-day span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    text-transform: uppercase;
  }

  .sample-day strong {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
  }

  .sample-day em {
    color: var(--color-threshold);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-style: normal;
    font-weight: var(--font-bold);
  }

  .hero-product {
    width: 100%;
  }

  @media (min-width: 1080px) {
    .hero-product {
      grid-column: 2;
    }
  }

  .form-card {
    max-width: 520px;
    margin: 0 auto;
    box-shadow: var(--shadow-xl);
  }

  @media (min-width: 1080px) {
    .form-card {
      margin: 0 0 0 auto;
    }
  }

  .pace-card-section {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border);
  }

  .pace-card-container {
    max-width: 900px;
  }

  .pace-card-head {
    max-width: 640px;
    margin-bottom: var(--space-8);
  }

  .pace-card-head h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-3);
  }

  .pace-card-head p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.65;
    margin: 0;
  }

  .pace-grid {
    display: grid;
    gap: var(--space-3);
