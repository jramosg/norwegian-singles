    ...group,
    pages: group.links
      .map((link) => {
        const page = relatedPages.find(
          (candidate) => candidate.slug === link.slug,
        );
        if (!page || isCurrentHref(`/${locale}/${page.slug}/`)) {
          return undefined;
        }
        return { ...page, summary: link.text };
      })
      .filter(
        (page): page is (typeof relatedPages)[number] & { summary: string } =>
          Boolean(page),
      ),
  }))
  .filter((group) => group.pages.length > 0);

const chartLabel = {
  en: 'Threshold',
  es: 'Umbral',
  ko: '역치',
  de: 'Schwelle',
  fr: 'Seuil',
  it: 'Soglia',
  'pt-BR': 'Limiar',
}[locale];

/** Keep "NSA / NSM" on one line inside large headings. */
const keepSlashTogether = (text: string) =>
  text.replace(/ \/ /g, '\u00a0/\u00a0');

// Session shapes for the "how to use these paces" rows, in card order:
// 3-minute reps, 6-minute reps, 10-minute reps, easy running.
const sessionShapes = [
  { reps: 9, minutes: 3, height: 15 },
  { reps: 5, minutes: 6, height: 16.5 },
  { reps: 3, minutes: 10, height: 17.5 },
  { reps: 1, minutes: 75, height: 8 },
].map(({ reps, minutes, height }) => {
  const recovery = reps > 1 ? 1 : 0;
  const total = reps * minutes + (reps - 1) * recovery;
  return Array.from({ length: reps }, (_, i) => ({
    x: (i * (minutes + recovery) * 100) / total,
    width: (minutes * 100) / total,
    y: 24 - height,
    height,
  }));
});
