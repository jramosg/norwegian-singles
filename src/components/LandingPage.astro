  .map((group) => ({
    ...group,
    pages: group.links
      .map((link) => {
        const page = relatedPages.find(
          (candidate) => candidate.slug === link.slug,
        );
        if (!page || isCurrentHref(`/${locale}/${page.slug}/`)) {
          return undefined;
        }
        return { ...page, summary: link.text };
      })
      .filter(
        (page): page is (typeof relatedPages)[number] & { summary: string } =>
          Boolean(page),
      ),
  }))
  .filter((group) => group.pages.length > 0);
